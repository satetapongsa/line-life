# คัดลอกไฟล์นี้เป็น .env.local สำหรับรันบนเครื่อง (ห้าม commit ไฟล์ .env.local)
# บน Vercel ให้ตั้งค่าที่ Project Settings > Environment Variables

# ---------- LINE ----------
# LIFF ID: LINE Developers > LINE Login channel > แท็บ LIFF
NEXT_PUBLIC_LIFF_ID=
# Channel ID ของ LINE Login channel เดียวกับที่สร้าง LIFF (แท็บ Basic settings) ใช้ verify ID token
LINE_LOGIN_CHANNEL_ID=

# ---------- Supabase (Project Settings > API) ----------
NEXT_PUBLIC_SUPABASE_URL=
# anon / publishable key (เปิดเผยได้ อ่านได้เฉพาะเมนูตาม RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role / secret key — ใช้ฝั่ง server เท่านั้น ห้ามใส่ NEXT_PUBLIC_ ข้างหน้าเด็ดขาด
SUPABASE_SERVICE_ROLE_KEY=

# ---------- ร้านค้า ----------
# เบอร์มือถือ (10 หลัก) หรือเลขบัตรประชาชน/นิติบุคคล (13 หลัก) ที่ผูกพร้อมเพย์
PROMPTPAY_ID=
# LINE userId ของแอดมิน คั่นด้วยคอมมา เช่น Uxxxxxxxx,Uyyyyyyyy
ADMIN_LINE_USER_IDS=
